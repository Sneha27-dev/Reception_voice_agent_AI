# Copy this file to .env and fill in your real API key.
# Never commit your actual .env file.

# Get a key from https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key-here

# Optional: which Groq model to use for extraction (default shown below)
GROQ_MODEL=llama-3.3-70b-versatile

# Optional: which Whisper model size to use (tiny/base/small/medium/large)
# "base" is a good balance of speed and accuracy for short calls.
WHISPER_MODEL=base
